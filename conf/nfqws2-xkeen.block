################################################################################
# nfqws-xkeen — переадресация помеченных пакетов mihomo → nfqws2
# Документация: https://github.com/chebyrnet/nfqws-xkeen
# Маркеры BEGIN/END нужны установщику — не удаляйте их.
################################################################################
# nfqws-xkeen BEGIN

# 1 = обрабатывать только пакеты с меткой mihomo (рекомендуется для связки XKeen).
# 0 = обычный режим nfqws2 (политика Keenetic / весь трафик по штатной логике).
XKEEN_MARK_ONLY=1

# Метка routing-mark из proxy NFQWS в mihomo (hex).
# В YAML mihomo то же значение в decimal: 268435456.
# Должна совпадать с routing-mark outbound'а, иначе пакеты в nfqws2 не попадут.
XKEEN_ROUTE_MARK=0x10000000

# Маска для iptables -m mark. Обычно равна метке (один бит).
XKEEN_ROUTE_MASK=0x10000000

# nfqws-xkeen END
################################################################################
